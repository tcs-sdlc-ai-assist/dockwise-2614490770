{
  "name": "dockwise-backend",
  "version": "1.0.0",
  "description": "Dockwise backend API - NestJS + TypeORM + PostgreSQL",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "node node_modules/ts-node-dev/bin/ts-node-dev --files --respawn src/main.ts",
    "test": "node node_modules/jest/bin/jest.js --runInBand",
    "migration:run": "node node_modules/typeorm/cli.js migration:run -d dist/config/data-source.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/typeorm": "^10.0.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "sql.js": "^1.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/sql.js": "^1.4.9",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
