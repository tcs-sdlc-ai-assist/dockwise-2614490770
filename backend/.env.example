# Server
PORT=3001
NODE_ENV=development
# Filesystem path of the SQLite database file (file-backed, no server)
DB_PATH=dockwise.db
# Auth
JWT_SECRET=
JWT_EXPIRES_IN=12h
# Gate/dock shared-device session length
DEVICE_SESSION_EXPIRES_IN=16h
# CORS: the frontend dev-server origin (must match the real dev port)
CORS_ORIGIN=http://localhost:5173
# Seed demo data on startup (idempotent)
SEED_ON_STARTUP=true
# Entra ID SSO (Meridian employees only in v1) - stubbed, disabled by default
ENTRA_SSO_ENABLED=false
# SMS provider (US-only, opt-in). Logged to outbox in v1; provider keys env-driven.
SMS_PROVIDER_API_KEY=
# Email provider. Logged to outbox in v1; provider keys env-driven.
EMAIL_PROVIDER_API_KEY=
