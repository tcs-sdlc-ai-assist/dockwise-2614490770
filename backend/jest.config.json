{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "rootDir": "src",
  "testRegex": ".*\\.spec\\.ts$",
  "moduleFileExtensions": ["ts", "js", "json"],
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "tsconfig": "<rootDir>/../tsconfig.json", "isolatedModules": true }]
  },
  "testTimeout": 30000,
  "maxWorkers": 1
}
